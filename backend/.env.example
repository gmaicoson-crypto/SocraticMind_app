# LLM_MODELS：OpenAI 兼容模型列表；未设置旧版 LLM_DEFAULT_MODEL_ID 时，第一项为默认模型。
# 必须是合法的非空 JSON 数组。
# 每项填写以下四个字段；内部 ID 由 BASE_URL + MODEL 自动生成，相同组合不能重复。
#   MODEL：服务商的模型标识，实际请求时传给服务商。
#   API_KEY：该模型服务的访问密钥，仅由后端使用，不会返回给前端。
#   BASE_URL：OpenAI 兼容接口地址，通常以 /v1 结尾。
#   NAME：前端模型选择器显示的名称，改名不会改变内部 ID。
# 下方未加引号的多行数组仅由本项目的 .env 解析器支持。
# 图片直接交给所选模型接口处理，无需配置图片能力或每图 token 上界。
# 每条消息最多 9 个附件；大小校验、图片压缩与上下文估算由系统统一管理。
# 实际图片识别能力取决于模型和接入接口；不支持时提示切换模型。
LLM_MODELS=[
  {
    "MODEL": "deepseek-chat",
    "API_KEY": "your_deepseek_key",
    "BASE_URL": "https://api.deepseek.com/v1",
    "NAME": "DeepSeek"
  },
  {
    "MODEL": "gpt-4o-mini",
    "API_KEY": "your_openai_key",
    "BASE_URL": "https://api.openai.com/v1",
    "NAME": "OpenAI"
  }
]
# SECRET_KEY：签发 JWT，并加密用户自行添加的模型密钥；请使用长期稳定的随机值。
# 更换后旧登录令牌失效，已保存的用户模型密钥也可能无法解密。
SECRET_KEY=change_me_to_a_random_secret_string

# DATABASE_URL：SQLAlchemy 数据库连接地址，后端服务和 Alembic 迁移共用。
# MySQL 格式：mysql+pymysql://用户名:密码@主机:端口/数据库名
DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/socraticmind

# 私有附件持久目录，不得通过静态文件服务公开。留空默认 backend/private_attachments。
# API 和解析 worker 必须访问同一持久卷，数据库与文件卷应配套备份。
ATTACHMENT_STORAGE_DIR=
# 头像上传目录；留空保留 backend/uploads/avatars，移动本地环境使用独立持久目录。
AVATAR_STORAGE_DIR=
# .doc/.ppt 必需；留空时自动寻找 PATH 中的 soffice 或 macOS 标准安装位置。
# 填可执行文件绝对路径；Linux 还需 bubblewrap，macOS 使用 sandbox-exec 隔离解析进程。
ATTACHMENT_LIBREOFFICE_PATH=

# CORS_ORIGINS：允许访问 API 的前端来源，多个值用逗号分隔；需包含协议和端口。
# 生产环境改为实际前端域名，不能只依赖此项进行身份认证。
CORS_ORIGINS=http://localhost:5173

# SMTP_HOST：验证码邮件服务器；留空时仅在后端日志打印验证码，不实际发送。
SMTP_HOST=smtp.example.com
# SMTP_PORT：邮件服务器端口；默认 SMTP_USE_TLS=true 使用 STARTTLS，通常配 587。
# 若服务商要求 465 端口，需另设 SMTP_USE_TLS=false，使用直接 TLS 连接。
SMTP_PORT=587
# SMTP_USER：邮件登录账号；为空时跳过登录，未设置 SMTP_FROM 时也作为发件地址。
SMTP_USER=your_email@example.com
# SMTP_PASSWORD：邮件登录密码或授权码，仅在配置 SMTP_USER 时用于认证。
SMTP_PASSWORD=your_email_password

# WEB_SEARCH_ENABLED：问答自动联网总开关；完成真实质量、延迟和费用验收后再设为 true。
WEB_SEARCH_ENABLED=false
# TAVILY_API_KEY：Tavily 搜索密钥；留空时即使总开关为 true 也无法联网。
TAVILY_API_KEY=
# WEB_SEARCH_API_BASE：Tavily API 根地址，后端会拼接 /search；仅由服务端管理员配置。
WEB_SEARCH_API_BASE=https://api.tavily.com
# WEB_DECISION_TIMEOUT_SECONDS：模型判断是否搜索的总等待秒数（含排队），范围 (0, 30]。
WEB_DECISION_TIMEOUT_SECONDS=5
# WEB_SEARCH_TIMEOUT_SECONDS：一批最多两条搜索查询共用的等待秒数，范围 (0, 60]。
WEB_SEARCH_TIMEOUT_SECONDS=8
# WEB_DECISION_INPUT_TOKENS：联网判断可用的输入 token 上限，范围 512-32000。
WEB_DECISION_INPUT_TOKENS=6000
# WEB_DECISION_OUTPUT_TOKENS：联网判断模型的输出 token 上限，不限制最终回答；范围 128-16384。
WEB_DECISION_OUTPUT_TOKENS=2048
# WEB_EVIDENCE_TOKENS：注入最终回答的搜索证据上限，还受模型剩余上下文限制；范围 128-16000。
WEB_EVIDENCE_TOKENS=4000
# WEB_SEARCH_DAILY_QUERY_LIMIT：每位用户按 UTC 自然日可用的查询数；0 表示禁用搜索。
WEB_SEARCH_DAILY_QUERY_LIMIT=100
# WEB_SEARCH_GLOBAL_DAILY_QUERY_LIMIT：所有用户共用的 UTC 每日查询数上限；0 表示禁用。
# 查询数在调用前预占，取消后不返还；此值不是服务商实际账单金额上限。
WEB_SEARCH_GLOBAL_DAILY_QUERY_LIMIT=1000
# WEB_SEARCH_MAX_WORKERS：每个后端进程供联网判断和搜索共用的工作线程数，范围 1-64。
WEB_SEARCH_MAX_WORKERS=8
# CHAT_STREAM_MAX_WORKERS：每个后端进程处理回答流的线程数，独立于搜索；范围 1-128。
CHAT_STREAM_MAX_WORKERS=8
# WEB_SEARCH_MAX_PENDING：联网工作线程之外允许排队的任务数，范围 0-128。
WEB_SEARCH_MAX_PENDING=8
# WEB_SEARCH_MAX_RESPONSE_BYTES：单条 Tavily 响应的最大读取字节数，范围 1024-8000000。
WEB_SEARCH_MAX_RESPONSE_BYTES=1000000
